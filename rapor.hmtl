<!DOCTYPE html>
<html lang="id" class="dark">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="theme-color" content="#101415" />
<title>Rapor PDF — SP-PPT</title>
<link rel="manifest" href="manifest.json" /><link rel="icon" href="assets/img/logo-sekolah.png" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<script>tailwind.config={darkMode:'class',theme:{extend:{colors:{surface:'#101415','surface-container':'#1d2022','surface-container-high':'#272a2c','on-surface':'#e0e3e5','on-surface-variant':'#c8c5d0','outline-variant':'#47464f',primary:'#c4c1fb','on-primary':'#2d2a5b','primary-container':'#1e1b4b',secondary:'#ffb77d','tertiary':'#b4c5ff','error':'#ffb4ab'},fontFamily:{headline:['"Plus Jakarta Sans"','sans-serif'],body:['Inter','sans-serif']}}}};</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<link rel="stylesheet" href="assets/css/style.css" />
</head>
<body class="font-body bg-surface text-on-surface min-h-screen">

<div class="fixed inset-0 z-0 pointer-events-none no-print">
  <img src="https://iili.io/nJ1Rcj1.png" alt="" class="w-full h-full object-cover opacity-20" />
  <div class="absolute inset-0" style="background:linear-gradient(to bottom, rgba(16,20,21,0.95), rgba(16,20,21,0.98));"></div>
</div>

<header class="fixed top-0 right-0 left-0 h-16 glass z-30 border-b border-outline-variant/40 flex items-center justify-between px-4 gap-3 no-print">
  <div class="flex items-center gap-3">
    <a href="dashboard.html" class="p-2 rounded-lg hover:bg-surface-container"><span class="material-symbols-outlined">arrow_back</span></a>
    <h2 class="font-headline font-semibold text-lg">Rapor PDF</h2>
  </div>
  <div class="flex items-center gap-2">
    <button id="btn-cetak" class="px-3 py-2 rounded-lg bg-primary text-on-primary text-xs font-medium flex items-center gap-1"><span class="material-symbols-outlined text-sm">print</span> Cetak</button>
    <button id="btn-pdf-lengkap" class="px-3 py-2 rounded-lg bg-secondary text-on-secondary text-xs font-medium flex items-center gap-1"><span class="material-symbols-outlined text-sm">download</span> PDF Lengkap</button>
    <button id="btn-pdf-ringkas" class="hidden sm:flex px-3 py-2 rounded-lg bg-tertiary text-on-tertiary text-xs font-medium items-center gap-1"><span class="material-symbols-outlined text-sm">description</span> Ringkas</button>
  </div>
</header>

<main class="relative z-10 pt-16 pb-8">
  <div class="p-4 lg:p-6 max-w-4xl mx-auto">
    <div id="rapor-content" class="bg-white text-black rounded-2xl shadow-2xl p-8 lg:p-10"></div>
  </div>
</main>

<div id="toast-container" class="fixed top-20 right-4 z-[100] space-y-2"></div>
<script type="module" src="assets/js/rapor.js"></script>
</body>
</html>